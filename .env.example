# Optional settings. Cargo and the engine do not automatically load this file.
# The default engine uses paper execution. Never put real credentials here.
RUSTCORE_GRPC_ADDR=127.0.0.1:50051
RUSTCORE_GRPC_AUTH_TOKEN=<replace-with-local-test-token>
RUSTCORE_DB_URL=sqlite://./data/rustcore.db
ENGINE_LIVE_ENABLED=0
ENGINE_STAGE_MAX=paper
BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://demo-fstream.binance.com

# Optional testnet credentials for credential id "testnet" (UTF-8 hex locator).
BINANCE_VENUE_H746573746E6574=testnet
BINANCE_API_KEY_H746573746E6574=<replace-with-testnet-api-key>
BINANCE_API_SECRET_H746573746E6574=<replace-with-testnet-api-secret>
